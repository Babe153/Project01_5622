#!/bin/bash
# Lab 1 section 2.1: BET with individually reviewed -f/-g/-c settings.
# Usage: bash SkullStripping
# Optional: SUBJECT_ID=Data_00 bash SkullStripping
# Table: bet_parameters.csv; override path with BET_PARAMETERS_FILE.
# BET_OPTIONS overrides the table for ONE SUBJECT_ID; BET_DRY_RUN=1 prints only.
set -eo pipefail
root_path="${PROJECT_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
data_root="$root_path/Data"
output_path="${SKULL_OUTPUT_ROOT:-$root_path/Output}"
export FSLDIR="${FSLDIR:-/home/elec5622/fsl}"
[[ -r "$FSLDIR/etc/fslconf/fsl.sh" ]] || { echo "FSL setup not found: $FSLDIR" >&2; exit 1; }
export PATH="$FSLDIR/share/fsl/bin:$FSLDIR/bin:$PATH"
. "$FSLDIR/etc/fslconf/fsl.sh"
export FSLOUTPUTTYPE=NIFTI_GZ LC_ALL=C
set -u
shopt -s nullglob
command -v bet >/dev/null
[[ "${BET_DRY_RUN:-0}" == 0 || "${BET_DRY_RUN:-0}" == 1 ]] || { echo 'BET_DRY_RUN must be 0 or 1.' >&2; exit 1; }
[[ -z "${SUBJECT_ID:-}" || "${SUBJECT_ID}" =~ ^Data_[0-9][0-9]$ ]] || { echo 'Invalid SUBJECT_ID.' >&2; exit 1; }

parameter_file="${BET_PARAMETERS_FILE:-$root_path/bet_parameters.csv}"
declare -A parameter_options parameter_centres
if [[ -f "$parameter_file" ]]; then
    # Numeric CSV only: never source/eval a parameter table. Validate the entire
    # table before running BET, including duplicates and incomplete centres.
    validated_rows="$(awk -F, '
        function fail(message) { print "Invalid BET parameter table, line " NR ": " message > "/dev/stderr"; exit 1 }
        function number(s) { return s ~ /^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)$/ }
        { sub(/\r$/, "") }
        NR == 1 { if ($0 != "subject_id,f,g,cx,cy,cz") fail("expected subject_id,f,g,cx,cy,cz header"); next }
        NF != 6 { fail("expected six fields") }
        {
            if ($1 !~ /^Data_[0-9][0-9]$/) fail("invalid subject ID")
            if (seen[$1]++) fail("duplicate subject ID " $1)
            if (!number($2) || $2 < 0 || $2 > 1) fail("f must be between 0 and 1")
            if (!number($3) || $3 < -1 || $3 > 1) fail("g must be between -1 and 1")
            empty = ($4 == "") + ($5 == "") + ($6 == "")
            if (empty != 0 && empty != 3) fail("provide all three centre coordinates or leave all blank")
            if (empty == 0) for (i = 4; i <= 6; i++) if ($i !~ /^[0-9]+$/) fail("centre coordinates must be nonnegative integers")
            print
        }
        END { if (NR == 0) { print "Empty BET parameter table" > "/dev/stderr"; exit 1 } }
    ' "$parameter_file")"
    [[ -n "$validated_rows" ]] || { echo 'BET parameter table contains no subjects.' >&2; exit 1; }
    while IFS=, read -r subject fractional gradient cx cy cz; do
        options="-f $fractional -g $gradient"
        if [[ -n "$cx" ]]; then
            options+=" -c $cx $cy $cz"
            parameter_centres["$subject"]="$cx $cy $cz"
        fi
        parameter_options["$subject"]="$options"
    done <<< "$validated_rows"
    echo "[SkullStripping] Parameter table: $parameter_file"
elif [[ -n "${BET_PARAMETERS_FILE:-}" ]]; then
    echo "Parameter table not found: $parameter_file" >&2; exit 1
else
    echo '[SkullStripping] No parameter table found; using default BET.'
fi

override_options=()
if [[ -n "${BET_OPTIONS:-}" ]]; then
    [[ -n "${SUBJECT_ID:-}" ]] || { echo 'Set SUBJECT_ID when using BET_OPTIONS.' >&2; exit 1; }
    read -r -a override_options <<< "$BET_OPTIONS"
    # Limit refinements to the teacher's f/g/c parameters; no shell evaluation.
    for ((i=0; i<${#override_options[@]}; )); do
        flag="${override_options[$i]}"; i=$((i+1))
        case "$flag" in
            -f|-g)
                (( i < ${#override_options[@]} )) || { echo "Missing value for $flag" >&2; exit 1; }
                value="${override_options[$i]}"; i=$((i+1))
                [[ "$value" =~ ^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || { echo "Invalid value for $flag" >&2; exit 1; }
                minimum=0; [[ "$flag" == -g ]] && minimum=-1
                awk -v n="$value" -v lo="$minimum" 'BEGIN { exit !(n >= lo && n <= 1) }' || { echo "Out-of-range value for $flag" >&2; exit 1; }
                ;;
            -c)
                (( i + 2 < ${#override_options[@]} )) || { echo '-c needs three voxel coordinates.' >&2; exit 1; }
                for j in 0 1 2; do
                    [[ "${override_options[$((i+j))]}" =~ ^[0-9]+$ ]] || { echo 'Invalid centre coordinate.' >&2; exit 1; }
                done
                parameter_centres["$SUBJECT_ID"]="${override_options[$i]} ${override_options[$((i+1))]} ${override_options[$((i+2))]}"
                i=$((i+3));;
            *) echo "Unsupported BET_OPTIONS flag: $flag (use -f/-g/-c)" >&2; exit 1;;
        esac
    done
    # An override replaces the entire table row, including its centre setting.
    if [[ " $BET_OPTIONS " != *" -c "* ]]; then unset 'parameter_centres[$SUBJECT_ID]'; fi
fi

# Preflight every selected image before creating or replacing any output.
inputs=(); splits=(); subjects=(); commands=(); sources=()
declare -A seen_inputs
for split in train test; do
    [[ -d "$data_root/$split" ]] || { echo "Missing: $data_root/$split" >&2; exit 1; }
    images=("$data_root/$split/"*.nii "$data_root/$split/"*.nii.gz)
    for input_image in "${images[@]}"; do
        subID="${input_image##*/}"; subject="${subID%%.*}"
        [[ -z "${SUBJECT_ID:-}" || "$subject" == "$SUBJECT_ID" ]] || continue
        [[ -z "${seen_inputs[$subject]+present}" ]] || { echo "Duplicate input subject: $subject" >&2; exit 1; }
        seen_inputs["$subject"]=1
        if (( ${#override_options[@]} )); then
            options="$BET_OPTIONS"; source='BET_OPTIONS override'
        elif [[ -f "$parameter_file" ]]; then
            [[ -n "${parameter_options[$subject]+present}" ]] || { echo "Missing parameter row: $subject" >&2; exit 1; }
            options="${parameter_options[$subject]}"; source="$parameter_file"
        else
            options=''; source='BET defaults'
        fi
        if [[ -n "${parameter_centres[$subject]:-}" ]]; then
            read -r -a centre <<< "${parameter_centres[$subject]}"
            for axis in 1 2 3; do
                dimension="$(fslval "$input_image" "dim$axis")"
                (( 10#${centre[$((axis-1))]} < dimension )) || { echo "Centre outside image: $subject axis $axis" >&2; exit 1; }
            done
        fi
        inputs+=("$input_image"); splits+=("$split"); subjects+=("$subject")
        commands+=("$options"); sources+=("$source")
    done
done
(( ${#inputs[@]} > 0 )) || { echo 'No matching MRI images found.' >&2; exit 1; }

if [[ "${BET_DRY_RUN:-0}" != 1 ]]; then
    mkdir -p "$root_path/Logs"
    manifest="$root_path/Logs/SkullStripping_$(date -u +%Y%m%d_%H%M%S)_$$.tsv"
    printf 'subject_id\tsplit\tbet_options\tparameter_source\toutput\n' > "$manifest"
fi
for ((i=0; i<${#inputs[@]}; i++)); do
    base="$output_path/${splits[$i]}/${subjects[$i]}"
    bet_options=()
    [[ -z "${commands[$i]}" ]] || read -r -a bet_options <<< "${commands[$i]}"
    echo "[SkullStripping] ${subjects[$i]} (${splits[$i]})"
    printf 'Command: bet '; printf '%q ' "${inputs[$i]}" "${base}_brain.nii.gz" "${bet_options[@]}" -m; printf '\n'
    [[ "${BET_DRY_RUN:-0}" != 1 ]] || continue
    mkdir -p "$output_path/${splits[$i]}"
    bet "${inputs[$i]}" "${base}_brain.nii.gz" "${bet_options[@]}" -m
    [[ -s "${base}_brain.nii.gz" && -s "${base}_brain_mask.nii.gz" ]]
    printf '%s\t%s\t%s\t%s\t%s\n' "${subjects[$i]}" "${splits[$i]}" "${commands[$i]}" "${sources[$i]}" "${base}_brain.nii.gz" >> "$manifest"
done
echo "SkullStripping finished: ${#inputs[@]} subject(s)."
[[ "${BET_DRY_RUN:-0}" == 1 ]] || echo "Run record: $manifest"
